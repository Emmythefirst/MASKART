# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/MasKart

# Solana Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Privacy Cash SDK (will add real values later)
PRIVACY_CASH_ENABLED=false
PRIVACY_CASH_PROGRAM_ID=

# File Upload Settings
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.pdf,.epub,.zip,.mp4,.mp3,.png,.jpg,.jpeg,.gif

# Encryption
ENCRYPTION_KEY=change-this-to-a-random-32-character-secret-key-immediately

# IPFS Configuration (using public gateway for MVP)
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=https://ipfs.infura.io:5001/api/v0

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Order Settings
ORDER_EXPIRY_HOURS=24
DOWNLOAD_LINK_EXPIRY_HOURS=48

# Starpay Configuration
STARPAY_API_KEY=your_api_key_here
STARPAY_API_URL=https://www.starpay.cards/api/v1