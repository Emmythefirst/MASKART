# Backend environment sample
# Copy to .env and set appropriate values for your environment

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/maskart

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# (Optional) Privacy Cash program ID to validate transactions
PRIVACY_CASH_PROGRAM_ID=

# Other envs...
PORT=5000
